# Copy to .env. Never commit keys.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Optional paid provider. Used ONLY when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Required for live analysis when APP_ENV=production. Use a long random value.
APP_ACCESS_KEY=
APP_ENV=development
DATABASE_PATH=data/reviewlens.db
JOB_TIMEOUT_SECONDS=600
MAX_PENDING_JOBS=8
LIVE_JOBS_PER_HOUR=10
RETENTION_DAYS=7
